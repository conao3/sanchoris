{
  "name": "sanchoris",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:schema:check": "node scripts/db-schema-check.mjs",
    "build": "pnpm --filter @sanchoris/frontend build",
    "lint": "pnpm --filter @sanchoris/frontend lint",
    "check": "pnpm --filter @sanchoris/frontend check && pnpm run db:schema:check"
  },
  "devDependencies": {
    "portless": "^0.13.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "^5.0.6",
      "ws@>=8.0.0 <8.20.1": "^8.20.1"
    }
  }
}
