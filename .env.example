# Sanchoris environment template (placeholders only).
#
# Convention: every `.env*` file is treated as secret and is gitignored; only
# `*.example` is committed. Copy this file to the gitignored `.env.local` and
# fill in the real values:
#
#   cp .env.example .env.local
#
# `.envrc` loads `.env.local` after `use flake`, so these values override the
# worktrunk block of `.env`; `scripts/dev.mjs` also reads `.env.local`, checks
# that every required variable is set, and passes them to `sanchoris all` and
# Vite. `scripts/dev.mjs` sets the per-run values itself: SANCHORIS_BIND_ADDR,
# SANCHORIS_CONTROL_URL, SANCHORIS_WORKSPACE_COMMAND, SANCHORIS_DOCS_DIR, SANCHORIS_SOCKET_DIR,
# SANCHORIS_WORKSPACES_DIR, SANCHORIS_FRONTEND_DIR (after building the
# frontend), and (for local records) SANCHORIS_RECORDS_DIR.
# The sanchoris binary reads every variable without a default and stops with
# the list of missing ones.
#
# Where the real values come from:
#   COGNITO_USER_POOL_ID / COGNITO_CLIENT_ID:
#     aws-infra-k8s CloudFormation exports. Read them with:
#       aws cloudformation list-exports \
#         --query "Exports[?Name=='dev-k8s-UserPool'||Name=='dev-k8s-SanchorisUserPoolClient'].[Name,Value]" \
#         --output text
#     dev-k8s-UserPool        -> COGNITO_USER_POOL_ID
#     dev-k8s-SanchorisUserPoolClient -> COGNITO_CLIENT_ID (also used as VITE_COGNITO_CLIENT_ID)
#   VITE_COGNITO_DOMAIN: custom Hosted UI domain (NOT *.amazoncognito.com).
#     dev: dev-auth-k8s.sancode.dev   prd: auth-k8s.sancode.dev
#   SANCHORIS_TABLE_* / AWS_ENDPOINT_URL_DYNAMODB: the worktrunk block of .env
#     sets them for DynamoDB Local (`pnpm dynamo:local`, `pnpm dynamo:create`).
#     The Cognito AWS region is derived from the pool id prefix (e.g.
#     ap-northeast-1_xxxx -> ap-northeast-1).
#   GITHUB_APP_*: the GitHub App settings page (App ID, client ID, a generated
#     client secret, a generated private key, the webhook secret you set, and
#     the slug from the public page URL https://github.com/apps/<slug>).
#   STRIPE_*: Stripe dashboard -> Developers (a test-mode secret key and the
#     webhook endpoint's signing secret), the customer portal configuration
#     id, and the price ids of the paid plans. In dev they are the SSM
#     parameters under /dev-k8s/sanchoris/ (stripe-secret-key,
#     stripe-webhook-secret, stripe-portal-config, stripe-price-<plan>).
#   Signing keys: at least 32 bytes each, e.g. `openssl rand -hex 32`.
#   SANCHORIS_CREDENTIAL_KEY: 32 random bytes in base64, e.g.
#     `openssl rand -base64 32`.

# --- Database and sign-in ---

# DynamoDB Local accepts any credentials and region; set these when no AWS
# profile is configured. The table names and the endpoint come from the
# worktrunk block of .env.
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Cognito user pool id, e.g. ap-northeast-1_xxxxxxxxx (export dev-k8s-UserPool).
COGNITO_USER_POOL_ID=

# Cognito app client id (export dev-k8s-SanchorisUserPoolClient).
COGNITO_CLIENT_ID=

# Public origin of the app; the GitHub App callback URL is
# <SANCHORIS_PUBLIC_URL>/auth/github/callback.
SANCHORIS_PUBLIC_URL=https://sanchoris.localhost

# --- GitHub App ---

GITHUB_URL=https://github.com
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
# PEM on one line with \n between lines, inside double quotes.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Set the App's Setup URL to <SANCHORIS_PUBLIC_URL>/auth/github/setup.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Workspaces clone <SANCHORIS_GIT_URL>/<owner>/<name>.git with your local git
# credentials.
SANCHORIS_GIT_URL=https://github.com

# --- Stripe ---

STRIPE_API_URL=https://api.stripe.com
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Customer portal configuration id; every portal session names it.
STRIPE_PORTAL_CONFIGURATION=bpc_
# Price ids of the paid plans, written into PLANS by `pnpm dynamo:create`.
SANCHORIS_STRIPE_PRICE_STARTER=price_
SANCHORIS_STRIPE_PRICE_PRO=price_
SANCHORIS_STRIPE_PRICE_MAX=price_

# --- Signing and encryption keys ---

RUN_TOKEN_SIGNING_KEY=
TASK_TOKEN_SIGNING_KEY=
OAUTH_STATE_SIGNING_KEY=
SANCHORIS_CREDENTIAL_KEY=

# --- Session records ---

# `local` stores records and audit exports under .sanchoris/dev/records and
# serves signed /records/... URLs from the api; `s3` presigns S3 URLs for
# SANCHORIS_RECORDS_BUCKET, encrypted with the KMS key
# SANCHORIS_RECORDS_KMS_KEY (key ARN or alias) and the tenant id in the
# encryption context.
SANCHORIS_RECORDS_STORE=local
RECORDS_SIGNING_KEY=
# SANCHORIS_RECORDS_BUCKET=
# SANCHORIS_RECORDS_KMS_KEY=alias/dev-k8s-sanchoris

# --- Frontend (Vite, VITE_* baked at build/dev; passed through scripts/dev.mjs) ---

# Cognito Hosted UI custom domain, host only (no scheme).
VITE_COGNITO_DOMAIN=dev-auth-k8s.sancode.dev

# Same value as COGNITO_CLIENT_ID (paste it literally).
VITE_COGNITO_CLIENT_ID=
