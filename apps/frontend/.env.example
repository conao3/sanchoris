# Cognito Hosted UI config for the frontend (Vite, baked at build/dev time).
# Real values live in the gitignored repo-root .envrc.local; placeholders only here.

# Cognito Hosted UI custom domain, host only (no scheme).
# dev: dev-auth-k8s.sancode.dev  prd: auth-k8s.sancode.dev
VITE_COGNITO_DOMAIN=

# Cognito app client id (public client, no secret). Same value as backend COGNITO_CLIENT_ID.
VITE_COGNITO_CLIENT_ID=

# Backend origin for the Vite dev proxy (/api -> backend). Unchanged by the auth work.
VITE_BACKEND_URL=
