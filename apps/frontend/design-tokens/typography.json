{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "IBM Plex Sans" },
      "mono": { "$type": "fontFamily", "$value": "IBM Plex Mono" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "text": {
    "size": {
      "2xs": { "$type": "dimension", "$value": "11px" },
      "xs": { "$type": "dimension", "$value": "11.5px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "ctl": { "$type": "dimension", "$value": "12.5px" },
      "base": { "$type": "dimension", "$value": "13px" },
      "lg": { "$type": "dimension", "$value": "15px" },
      "h1": { "$type": "dimension", "$value": "20px" },
      "auth": { "$type": "dimension", "$value": "24px" }
    }
  }
}
