{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Cormorant Garamond"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "JetBrains Mono"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "text": {
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "11px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "12px"
      },
      "base": {
        "$type": "dimension",
        "$value": "14px"
      },
      "md": {
        "$type": "dimension",
        "$value": "14.5px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "16px"
      },
      "h3": {
        "$type": "dimension",
        "$value": "26px"
      },
      "h2": {
        "$type": "dimension",
        "$value": "38px"
      },
      "h1": {
        "$type": "dimension",
        "$value": "48px"
      },
      "hero": {
        "$type": "dimension",
        "$value": "58px"
      }
    }
  },
  "leading": {
    "tight": {
      "$type": "number",
      "$value": 1
    },
    "heading": {
      "$type": "number",
      "$value": 1.05
    },
    "snug": {
      "$type": "number",
      "$value": 1.4
    },
    "body": {
      "$type": "number",
      "$value": 1.55
    },
    "relaxed": {
      "$type": "number",
      "$value": 1.65
    }
  },
  "tracking": {
    "tighter": {
      "$type": "dimension",
      "$value": "-1px"
    },
    "tight": {
      "$type": "dimension",
      "$value": "-0.5px"
    },
    "normal": {
      "$type": "dimension",
      "$value": "0"
    },
    "wide": {
      "$type": "dimension",
      "$value": "0.16em"
    },
    "wider": {
      "$type": "dimension",
      "$value": "0.24em"
    }
  }
}
