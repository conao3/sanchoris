{
  "$schema": "https://schemas.tokens.studio/latest/tokens-schema.json",
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "IBM Plex Sans" },
      "mono": { "$type": "fontFamily", "$value": "IBM Plex Mono" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "text": {
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "h1": { "$type": "dimension", "$value": "1.25rem" },
      "auth": { "$type": "dimension", "$value": "1.75rem" }
    },
    "lineHeight": {
      "xs": { "$type": "dimension", "$value": "1rem" },
      "sm": { "$type": "dimension", "$value": "1.25rem" },
      "base": { "$type": "dimension", "$value": "1.5rem" },
      "h1": { "$type": "dimension", "$value": "1.75rem" },
      "auth": { "$type": "dimension", "$value": "2.25rem" }
    }
  }
}
