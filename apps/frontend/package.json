{
  "name": "@sanchoris/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --name sanchoris -- pnpm run dev:app",
    "dev:app": "vite --host 127.0.0.1 --port ${PORT:-5173}",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "pnpm run codegen && knip",
    "build": "pnpm run codegen && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "pnpm run codegen && tsc -b --pretty false && pnpm run lint"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@graphql-typed-document-node/core": "^3.2.0",
    "graphql": "^16.14.0",
    "react": "latest",
    "react-aria-components": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "knip": "^6.11.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
