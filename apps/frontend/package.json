{
  "name": "@sanchoris/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "portless run --name sanchoris -- pnpm run dev:app",
    "dev:app": "vite --host 127.0.0.1 --port ${PORT:-5173}",
    "dev:mock": "VITE_MOCK_API=1 pnpm run dev:app",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "pnpm run codegen && knip",
    "build": "pnpm run codegen && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "pnpm run codegen && tsc -b --pretty false && pnpm run lint"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@graphql-tools/mock": "^10.1.2",
    "@graphql-tools/schema": "^11.0.7",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "knip": "^6.43.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
